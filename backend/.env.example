# Copy to .env and set local values. Never commit .env.
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialsync
DB_USER=postgres
DB_PASSWORD=

# Shared webhook handshake; META_VERIFY_TOKEN is a legacy alias.
WEBHOOK_VERIFY_TOKEN=

# Facebook Messenger
META_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v26.0

# Instagram API with Instagram Login
# IG_PAGE_ID is the Instagram professional account ID used to filter webhooks.
# IG_PAGE_ACCESS_TOKEN is an Instagram user access token despite the legacy name.
IG_APP_SECRET=
IG_PAGE_ID=
IG_PAGE_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v26.0
